# Local-only login password; use a unique value at least 12 characters long.
MARGIN_PASSWORD=change-me-to-a-long-random-password
# Database, job state, and extracted source text live here.
MARGIN_DATA_DIR=./.data
# Optional; set only for trusted-home-Wi-Fi iPhone testing with `npm run dev:lan`.
# Must be this computer's RFC1918 private IPv4 address.
# MARGIN_HOST=192.168.1.20

# Optional. Required only to generate summaries. Never put a real key in this file.
OPENAI_API_KEY=
# Default is gpt-4.1-mini. Override only with a model enabled for your API project.
OPENAI_MODEL=gpt-4.1-mini
