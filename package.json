{
  "name": "margin",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n web,worker -c blue,green \"next dev --hostname 127.0.0.1\" \"node --conditions=react-server --import tsx scripts/worker.ts\"",
    "dev:lan": "node scripts/dev-lan.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "worker": "node --conditions=react-server --import tsx scripts/worker.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "@next/env": "15.5.28",
    "better-sqlite3": "^12.2.0",
    "ipaddr.js": "^2.2.0",
    "jsdom": "^26.1.0",
    "next": "^15.5.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^22.15.30",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.7",
    "concurrently": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
